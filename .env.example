# Optional AI judge (the deterministic scorer works without it)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional Arize / Phoenix tracing (LLM observability "signals")
ENABLE_PHOENIX=0
PHOENIX_PROJECT_NAME=veritas-judge-agent
# --- Option A: Arize AX (app.arize.com) — needs BOTH api_key and space_id ---
# PHOENIX_API_KEY=your_arize_api_key
# PHOENIX_COLLECTOR_ENDPOINT=https://otlp.arize.com/v1/traces
# ARIZE_SPACE_ID=your_arize_space_id   # required for Arize AX (Space Settings)
# --- Option B: Arize Phoenix Cloud (app.phoenix.arize.com) ---
# PHOENIX_API_KEY=your_phoenix_key
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com

# Optional custom endpoints (defaults shown)
SEARCHER_AGENT_URL=http://127.0.0.1:5001/search
EXTRACTOR_AGENT_URL=http://127.0.0.1:5002/extract
FRIEND_AGENT_URL=http://127.0.0.1:5003
