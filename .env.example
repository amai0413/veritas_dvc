# Optional AI judge (the deterministic scorer works without it)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional Phoenix tracing
ENABLE_PHOENIX=0
PHOENIX_API_KEY=your_phoenix_key_here
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/v1/traces
PHOENIX_PROJECT_NAME=veritas-judge-agent

# Optional custom endpoints (defaults shown)
SEARCHER_AGENT_URL=http://127.0.0.1:5001/search
EXTRACTOR_AGENT_URL=http://127.0.0.1:5002/extract
FRIEND_AGENT_URL=http://127.0.0.1:5003
